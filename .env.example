# ====================================================================
# RAG-BOT 环境变量模板
# 使用：cp .env.example .env   然后按需改
# 所有变量都有默认值，没写也能跑
# ====================================================================

# ---------- 基础 ----------
APP_ENV=prod                      # dev / staging / prod
LOG_LEVEL=INFO                    # DEBUG / INFO / WARNING / ERROR
UVICORN_WORKERS=2                 # uvicorn worker 数，CPU 核数 + 1 最合适

# ---------- 数据库 ----------
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_bot
DB_USER=postgres
DB_PASSWORD=change-me           # ⚠️ 必填，不要把真实口令提交到仓库

# ---------- JWT 安全 ----------
# ⚠️ 生产务必用 openssl rand -hex 32 生成一个真随机字符串
JWT_SECRET=CHANGE-ME-IN-PRODUCTION-GENERATE-A-RANDOM-STRING

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:8008,http://localhost

# ---------- LLM Provider ----------
# 本地 Ollama（默认）
LLM_PROVIDER=ollama

# 云端模型示例（用哪个就把 LLM_PROVIDER 改成下面的，其他两个注释掉）
# --- DeepSeek / OpenAI 兼容 ---
# LLM_PROVIDER=openai_compat
# LLM_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-key-here
# --- 百度文心一言 ---
# LLM_PROVIDER=baidu_ernie
# LLM_API_KEY=your-baidu-api-key
# LLM_BASE=your-baidu-secret-key
# --- 阿里通义 DashScope ---
# LLM_PROVIDER=aliyun_dashscope
# LLM_API_KEY=your-dashscope-api-key

# ---------- 数字人服务（独立部署后在这里填地址）----------
# DIGITAL_HUMAN_URL=http://your-digital-human-server:8080
